<idea-plugin>
    <id>dev.slopreview</id>
    <name>Slop Review</name>
    <vendor>Slop Review</vendor>
    <description><![CDATA[
        Local code review for AI-written code. Open any diff — uncommitted changes or a commit —
        comment on the lines like in a pull request, and send the review back to your coding agent.
        The agent fixes the code and replies in the same threads, right under the code.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends optional="true" config-file="slopreview-terminal.xml">org.jetbrains.plugins.terminal</depends>

    <dependencies>
        <module name="intellij.platform.collaborationTools"/>
        <module name="intellij.platform.vcs.impl"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <diff.DiffExtension implementation="dev.slopreview.editor.SlopReviewDiffExtension"/>
        <editorFactoryListener implementation="dev.slopreview.editor.SlopReviewEditorListener"/>
        <postStartupActivity implementation="dev.slopreview.SlopReviewStartup"/>
        <toolWindow id="Slop Review" anchor="left" secondary="true" icon="/icons/toolWindow.svg"
                    factoryClass="dev.slopreview.toolwindow.SlopReviewToolWindowFactory"/>
        <notificationGroup id="Slop Review" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="SlopReview.AttachSession" class="dev.slopreview.actions.AttachSessionAction"
                text="Attach Session" description="Choose the terminal tab with Claude Code that receives this review"/>
        <action id="SlopReview.Send" class="dev.slopreview.actions.SendReviewAction"
                text="Send to AI" description="Send open review comments to the coding agent"
                icon="/icons/send.svg"/>
        <action id="SlopReview.AddComment" class="dev.slopreview.actions.AddReviewCommentAction"
                text="Add Slop Review Comment" description="Comment on the current line or selection for the AI"
                icon="/icons/ai.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift K"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="control shift K" replace-all="true"/>
        </action>
        <action id="SlopReview.ToggleEditorComments" class="dev.slopreview.actions.ToggleEditorCommentsAction"
                text="Show Slop Review Comments"
                description="Show review threads under the code in the editor; when off, only the gutter icon stays — click it to open a thread"
                icon="/icons/ai.svg">
            <add-to-group group-id="EditorGutterPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
